#!/bin/sh
#
# Removes any Claude / Anthropic co-author trailer from the commit message.
#
# This is a public portfolio repo, and commits carry no AI co-author (CLAUDE.md,
# "Git: things you must never do"). Tools that write commits can append
#   Co-Authored-By: Claude <noreply@anthropic.com>
# on their own, and GitHub then lists "claude" as a contributor, which cannot be
# undone without rewriting history. Stripping the line here makes the rule hold
# whoever or whatever writes the commit.
#
# Only trailers that name Claude or anthropic.com are removed; human co-authors
# stay. Runs for `git commit`, `git commit --amend` and merges that open an editor.
#
# Wired via `core.hooksPath=.githooks` (set by the `prepare` npm script).
# Escape hatch: git commit --no-verify

msg_file="$1"
[ -f "$msg_file" ] || exit 0

pattern='^[[:space:]]*co-authored-by:.*(claude|anthropic\.com)'

if grep -iEq "$pattern" "$msg_file"; then
  tmp="$msg_file.tmp.$$"
  grep -ivE "$pattern" "$msg_file" > "$tmp"
  # Drop the blank lines the removed trailer leaves at the end of the message.
  sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmp" > "$msg_file"
  rm -f "$tmp"
  echo "commit-msg: removed a Claude co-author trailer (this repo's commits carry none)."
fi

exit 0
