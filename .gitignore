# ---------------------------------------------------------------------------
# PRIVATE / PERSONAL — this repo is PUBLIC. Nothing below may be committed.
# ---------------------------------------------------------------------------
# Personal interview prep. Untracked on purpose: the Pages workflow builds from
# `actions/checkout`, so keeping it out of git guarantees it can never reach a
# production bundle. Loaded dev-only by AdminPage.tsx.
private/

# Belt-and-braces for personal documents dropped anywhere in the tree. These
# have been silently lost twice (a `git stash --include-untracked` round-trip
# drops them); if they go missing again, restore them before any `git add -A`.
*.pdf
*resume*
*Resume*
*CV.docx

# Build-time generated metadata (scripts/generate-content-meta.js).
# Regenerated by `npm run dev`/`build`/CI, so committing it would only go stale.
src/generated/

# Lighthouse report exports. Large, machine-generated and dated — they are read
# once and replaced by the next run, so they never belong in the repo. Note the
# report filename is derived from the audited URL, hence the two shapes.
*.report.json
localhost_*-*.json
sreen98.github.io-*.json
